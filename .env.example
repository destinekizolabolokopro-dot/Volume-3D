# ============================================================================
# Volume3D — variables d'environnement
# Copiez ce fichier en .env.local pour le développement,
# et reportez les mêmes clés dans Vercel → Settings → Environment Variables.
# ============================================================================

# --- Obligatoire : accès au back-office -------------------------------------
# Le mot de passe que VOUS taperez sur /admin/login
ADMIN_PASSWORD=changez-moi
# Chaîne aléatoire d'au moins 32 caractères, qui signe les sessions.
# Générez-la avec : openssl rand -base64 32
AUTH_SECRET=remplacez-par-une-chaine-aleatoire-de-32-caracteres-minimum

# --- Base de données et stockage --------------------------------------------
# Laissez vide en développement : les données vont dans le dossier .data/
# En production, renseignez les deux (Supabase → Settings → API).
SUPABASE_URL=
# Clé "service_role" — secrète. Ne jamais la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Nom du bucket de stockage public (à créer dans Supabase → Storage)
SUPABASE_BUCKET=tours

# --- Assistants (facultatif mais recommandé) --------------------------------
# Clé API Anthropic : https://console.anthropic.com
# Une seule clé pour les deux assistants du site :
#   — le chatbot des pages de visite (/v/{slug}) ;
#   — l'assistant juridique et ses treize spécialités (/juridique).
# Sans elle, les deux restent désactivés : les fiches des spécialités et les
# délais restent lisibles, mais aucune question ne peut être posée.
ANTHROPIC_API_KEY=

# --- Génération IA des aperçus de démarchage (facultatif) -------------------
# Sans clé, les aperçus affichent les photos d'origine sans extension IA.
# Clé Google AI Studio : https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
AI_IMAGE_MODEL=gemini-2.5-flash-image
# Mettre "none" pour désactiver complètement la génération.
AI_IMAGE_PROVIDER=

# --- Affichage public --------------------------------------------------------
# URL finale du site, utilisée pour composer les liens de visite.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=scan@volume3d.fr
# Le montant seul suffit : l'espace insécable avant l'euro est posé par le code
# (voir PRICE_PER_LISTING dans lib/content.ts), pas ici. Une règle typographique
# qui dépendrait de la façon dont cette ligne a été tapée n'en serait pas une.
NEXT_PUBLIC_PRICE=89€
# Slug du logement mis en avant dans la section « Avant / Après » de la landing.
NEXT_PUBLIC_FEATURED_SLUG=
