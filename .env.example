# Le mot de passe de l’espace de réglages, sur /reglages : douze caractères au
# minimum, sinon la porte refuse de s’ouvrir. C’est de là qu’on colle la clé du
# modèle sans redéployer. Il n’a rien à voir avec les comptes clients.
ADMIN_PASSWORD=

# La clé du modèle. Facultative SI vous la posez depuis /reglages — mais si
# elle est ici, elle l’emporte sur celle des réglages. Sans l’une ni l’autre,
# les fiches, les délais et le tableau des diagnostics restent consultables,
# mais aucune question ne reçoit de réponse.
ANTHROPIC_API_KEY=

# Le secret des sessions : seize caractères au minimum. Sans lui, aucun compte
# ne peut être créé — et la page de connexion le dit au lieu de laisser un
# compte orphelin en base.
AUTH_SECRET=

# La base. Sans ces deux variables, tout est écrit dans .data/ : pratique pour
# développer, perdu au premier redéploiement. En ligne, elles sont obligatoires.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# L’adresse publique. Elle sert aux métadonnées, au plan du site, et surtout
# aux LIENS DES COURRIELS : sans elle, un lien de confirmation ou de
# réinitialisation pointe vers localhost et n’arrive nulle part.
NEXT_PUBLIC_SITE_URL=

# L’envoi des courriels, par Resend : confirmation d’adresse et mot de passe
# oublié. Sans elle, les comptes fonctionnent mais une adresse ne peut pas être
# confirmée et un mot de passe perdu ne peut pas être repris — les écrans qui
# en dépendent le disent au lieu de proposer un champ inopérant. En
# développement, le lien est alors écrit dans la console du serveur.
RESEND_API_KEY=

# L’adresse d’expédition, au format « Nom <adresse@votre-domaine.fr> ». Sans
# elle, on retombe sur le domaine de bac à sable de Resend, qui n’écrit qu’au
# titulaire du compte : assez pour essayer, jamais pour ouvrir aux clients.
COURRIEL_EXPEDITEUR=

# Facultatif : tant qu’elle est absente, les changements de formule sont
# immédiats et gratuits, et chaque écran qui les propose l’écrit.
STRIPE_SECRET_KEY=
